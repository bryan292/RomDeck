{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RomDeck",
  "version": "0.1.0",
  "identifier": "app.romdeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../..",
    "devUrl": "http://127.0.0.1:5137",
    "beforeBuildCommand": "npm run build --prefix ../.. && npm run prepare:tauri-host --prefix ../..",
    "frontendDist": "../../web-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RomDeck",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Local-first ROM library manager",
    "longDescription": "RomDeck manages local EmulationStation and ES-DE ROM library folders.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon-512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "resources": {
      "resources/host/": "host/"
    }
  }
}
